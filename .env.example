# ============================================
# PROGRESS AYERE WhatsApp Bot - Environment Variables
# ============================================

# --------------------------------------------
# Google Gemini API Configuration
# --------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
# Free tier: 15 requests per minute, 1500 requests per day
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection
# Available free models:
# - gemini-1.5-flash (Latest, fast, FREE)
# - gemini-1.5-flash-8b (Faster, lightweight, FREE)
# - gemini-1.5-pro (Most capable, FREE with limits)
GEMINI_MODEL=your_gemini_model_here

# --------------------------------------------
# Optional: Other API Keys (not required)
# --------------------------------------------

# Weather API (optional - already using free wttr.in)
# Get from: https://www.weatherapi.com/
WEATHER_API_KEY=your_weather_api_key_here

# Wordnik API for Word of the Day (optional)
# Get from: https://developer.wordnik.com/
WORDNIK_API_KEY=

# --------------------------------------------
# Bot Configuration
# --------------------------------------------

# Bot Owner Phone Number (without @s.whatsapp.net)
BOT_OWNER_NUMBER=234xxxxxxxxxx

# Port for health check server (default: 3000)
PORT=3000

# Bot Environment (development/production)
NODE_ENV=production

# --------------------------------------------
# Notes:
# - Never commit this file to Git (.gitignore should exclude it)
# - Gemini API is 100% FREE with generous limits
# - Get your key: https://aistudio.google.com/app/apikey
# - Free tier: 15 RPM, 1500 requests/day, 1M tokens/min
# - Keep your API keys secure
# ============================================
